{
  "name": "vibe-mission-control",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security:check": "pnpm audit --prod --audit-level high",
    "vault:inspect": "node scripts/inspect-vault.mjs",
    "package:codex": "node scripts/package-codex.mjs",
    "verify": "node scripts/verify-release.mjs",
    "release:prepare": "node scripts/release-version.mjs prepare",
    "release:verify": "node scripts/release-version.mjs check",
    "release:notes": "node scripts/release-version.mjs notes",
    "release:check": "pnpm verify && pnpm release:verify && node --test scripts/release-version.test.mjs && pnpm security:check && bash -n scripts/bootstrap.sh scripts/build-release.sh",
    "release:build": "bash scripts/build-release.sh"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.1",
    "@playwright/test": "1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.0.15"
  }
}
