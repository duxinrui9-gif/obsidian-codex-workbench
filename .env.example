# Copy to .env.local. All WORKBENCH_* paths are relative to the Vault root.
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/obsidian-vault

# Keep the handoff package read-only until a temporary Vault has passed validation.
WORKBENCH_WRITE_ENABLED=false

# These defaults match the bundled fixture. Adapt them to the recipient Vault after inspection.
NEXT_PUBLIC_WORKBENCH_TIME_ZONE=Asia/Hong_Kong
WORKBENCH_TIME_ZONE=Asia/Hong_Kong
WORKBENCH_ACTIONS_DIR=05_Review/Actions
WORKBENCH_PROJECTS_DIR=03_Topics/项目
WORKBENCH_PROJECT_TEMPLATE=98_Templates/项目主页.md
WORKBENCH_COLLABORATORS_DIR=03_Topics/人物
WORKBENCH_COLLABORATOR_TEMPLATE=98_Templates/协作人角色卡.md
WORKBENCH_DAILY_DIR=05_Review/Daily
WORKBENCH_WEEKLY_DIR=05_Review/Weekly
WORKBENCH_MONTHLY_DIR=05_Review/Monthly
