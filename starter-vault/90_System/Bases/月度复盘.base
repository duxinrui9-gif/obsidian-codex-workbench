filters:
  and:
    - file.inFolder("05_Review/Monthly")
    - type == "review"
    - review_period == "monthly"
properties:
  file.name:
    displayName: 月份
  review_kind:
    displayName: 类型
  period_start:
    displayName: 开始
  period_end:
    displayName: 结束
  status:
    displayName: 状态
  projects:
    displayName: 项目
  metrics_as_of:
    displayName: 指标截至
  metric_completed_actions:
    displayName: 完成事项
  metric_carryover_events:
    displayName: 结转事件
  metric_waiting_actions:
    displayName: 等待事项
  metric_overdue_reviews:
    displayName: 逾期复查
  metric_overdue_deliveries:
    displayName: 逾期交付
  updated:
    displayName: 更新日期
views:
  - type: table
    name: 月报
    filters:
      and:
        - review_kind == "report"
    order:
      - month_key
      - file.name
  - type: table
    name: 月度规划
    filters:
      and:
        - review_kind == "plan"
    order:
      - month_key
      - file.name
